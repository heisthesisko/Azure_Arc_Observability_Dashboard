{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "oauth2Proxy": {
      "type": "object",
      "required": ["clientId", "existingSecret"],
      "properties": {
        "clientId": { "type": "string", "minLength": 1 },
        "existingSecret": {
          "type": "object",
          "required": ["name", "clientSecretKey", "cookieSecretKey"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "clientSecretKey": { "type": "string", "minLength": 1 },
            "cookieSecretKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "azureIdentity": {
      "type": "object",
      "required": ["tenantId", "clientId", "subscriptionId", "tokenAudience"],
      "properties": {
        "tenantId": { "type": "string", "minLength": 1 },
        "clientId": { "type": "string", "minLength": 1 },
        "subscriptionId": { "type": "string", "minLength": 1 },
        "tokenAudience": { "type": "string", "minLength": 1 },
        "tokenExpirationSeconds": {
          "type": "integer",
          "minimum": 600,
          "maximum": 86400
        }
      }
    },
    "foundry": {
      "type": "object",
      "required": ["enabled", "scopes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "scopes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "dashboard": {
      "type": "object",
      "required": ["administratorUsers", "port"],
      "properties": {
        "administratorUsers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        }
      }
    },
    "route": {
      "type": "object",
      "required": ["enabled", "host"],
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string", "minLength": 1 }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "const": true },
        "size": { "type": "string", "minLength": 1 }
      }
    }
  },
  "required": [
    "image",
    "oauth2Proxy",
    "foundry",
    "azureIdentity",
    "dashboard",
    "route",
    "persistence"
  ]
}
