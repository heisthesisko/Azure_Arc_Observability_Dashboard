{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "dashboard", "workloadIdentity", "oauth2Proxy", "persistence", "ingress"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-fA-F0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "dashboard": {
      "type": "object",
      "required": ["port"],
      "properties": {
        "port": { "const": 8766 },
        "administratorUsers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "workloadIdentity": {
      "type": "object",
      "required": ["clientId", "tenantId", "subscriptionId"],
      "properties": {
        "clientId": { "$ref": "#/definitions/guid" },
        "tenantId": { "$ref": "#/definitions/guid" },
        "subscriptionId": { "$ref": "#/definitions/guid" }
      }
    },
    "oauth2Proxy": {
      "type": "object",
      "required": ["tenantId", "existingSecret", "secretKeys"],
      "properties": {
        "tenantId": { "$ref": "#/definitions/guid" },
        "existingSecret": { "type": "string", "minLength": 1 },
        "allowedGroups": {
          "type": "array",
          "items": { "$ref": "#/definitions/guid" },
          "uniqueItems": true
        },
        "extraArgs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["accessModes", "size", "retain"],
      "properties": {
        "existingClaim": { "type": "string" },
        "size": { "type": "string", "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki)$" },
        "retain": { "type": "boolean" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["ReadWriteOnce", "ReadWriteOncePod"] }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["className", "host", "tls"],
      "properties": {
        "className": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 },
        "tls": {
          "type": "object",
          "required": ["secretName"],
          "properties": {
            "secretName": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "definitions": {
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  }
}
